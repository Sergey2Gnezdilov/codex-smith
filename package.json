{
  "name": "codex-smith",
  "version": "0.3.0",
  "description": "A secure Telegram control plane for local Codex agents, powered by the official Codex SDK with a CLI fallback.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts eslint.config.ts eslint.config.js ecosystem.config.ts ecosystem.config.cjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "healthcheck:strict": "tsx scripts/healthcheck.ts --strict",
    "healthcheck:live": "tsx scripts/healthcheck.ts --codex-live --telegram-live",
    "telegram:smoke": "tsx scripts/telegramSmoke.ts",
    "ci": "npm run check && npm run lint && npm run format:check && npm test && npm run healthcheck",
    "release:check": "npm run ci && npm run healthcheck:strict"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegraf",
    "codex",
    "openai",
    "codex-cli",
    "remote-coding",
    "ai-agent",
    "github-integration",
    "mcp",
    "subagents",
    "developer-tools",
    "skill",
    "node-pty",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "^0.153.4",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^8.0.0",
    "lodash.throttle": "^4.1.1",
    "node-cron": "^4.6.0",
    "node-pty": "^1.0.0",
    "simple-git": "^3.36.0",
    "strip-ansi": "^7.1.0",
    "telegraf": "^4.16.3",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
